{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(uv *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "WebFetch(domain:api.deepgram.com)"
    ]
  },
  "skillOverrides": {
    "deepgram:starters": "off",
    "deepgram:setup-mcp": "off"
  },
  "enabledPlugins": {
    "deepgram@deepgram-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "deepgram-agent-skills": {
      "source": {
        "source": "github",
        "repo": "deepgram/skills"
      }
    }
  }
}