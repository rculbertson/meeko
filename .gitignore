# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Logs (rotated files contain verbatim conversation transcripts)
meeko.log*

# Local SQLite DB (sessions/turns)
meeko.db
meeko.db-journal
meeko.db-wal
meeko.db-shm

# Per-host runtime config (personal). Lives at ~/.config/meeko/meeko.toml;
# a ./meeko.toml here is a supported cwd fallback for dev, so keep it ignored.
meeko.toml

# Tool-specific config (personal)
mise.toml
skills-lock.json

# Claude Code (transient runtime state & skills; .claude/settings.json stays tracked)
.claude/*
!.claude/settings.json

# Local agent customizations & skills
.agents/

# Test fixtures (generated — see README)
tests/fixtures/

# Coverage data
.coverage
htmlcov/

# Editor/IDE directories (defensive: never belongs in the public repo)
.idea/
.vscode/
*.code-workspace
*.iml
.DS_Store
