# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Logs
meeko.log

# Local SQLite DB (sessions/turns)
meeko.db
meeko.db-journal
meeko.db-wal
meeko.db-shm

# Per-host runtime config (personal). Lives at ~/.config/meeko/meeko.toml;
# a ./meeko.toml here is a supported cwd fallback for dev, so keep it ignored.
meeko.toml

# Tool-specific config (personal)
mise.toml
.claude/settings.local.json
# Claude Code runtime state (transient; .claude/settings.json stays tracked)
.claude/scheduled_tasks.lock

# Test fixtures (generated — see README)
tests/fixtures/

# Coverage data
.coverage
htmlcov/

# Private docs (not for public repo)
private/

# Editor/IDE directories (defensive: never belongs in the public repo)
.idea/
.vscode/
